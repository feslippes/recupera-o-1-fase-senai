programa {
  funcao inicio() {
    
inteiro qtd_inicial, qtd_final, qtd_vendida

escreva("com quantas laranjas voce começou o dia? ")
leia(qtd_inicial)

escreva("com quantas laranjas voce terminou o dia? ")
leia(qtd_final)

qtd_vendida = qtd_inicial - qtd_final

escreva("voce vendeu " + qtd_vendida + "laranjas hoje!")
leia(qtd_vendida)




  }
}
