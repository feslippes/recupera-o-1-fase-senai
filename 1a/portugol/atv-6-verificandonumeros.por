programa {
  funcao inicio() {
    
    
    //info
    inteiro par, impar, numero
    //entrada
    escreva("digite um numero e veremos pra você se ele é impar ou par: " )
    leia(numero)
    //processamento/saida
    se(numero == 1){
      escreva("numero impar!")
    }senao se( numero == 2){
     escreva("numero par!")
    }senao se(numero == 3){
     escreva("numero impar!")
    }senao se(numero == 4){
     escreva("numero par!")
    }senao se(numero == 5){
     escreva("numero impar!")
    }senao se(numero == 6){
     escreva("numero par!")
    }senao se(numero == 7){
     escreva("numero impar!")
    }senao se(numero == 8){
     escreva("numero par!")
    }senao se(numero == 9){
     escreva("numero impar!")
    }senao se(numero == 10){
     escreva("numero par!")
    }senao se(numero == 0){
      escreva("o numero zero não pode se aplicar, ele não é nem impar e nem par.")
    }senao{
      escreva("No momento não podemos usar numeros maiores que 10, ou abaixo de zero. lamentamos por isso.")
    }
    //saida




}
}