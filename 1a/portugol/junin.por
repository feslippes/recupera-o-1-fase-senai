programa {
  funcao inicio() {
    
   inteiro dias_trabalhado
  real slr_mensal
   real qnt_recebe

  escreva("dias trabalhados: ")
  leia(dias_trabalhado)

  escreva("salario mensal: ")
  leia(slr_mensal)

  qnt_recebe = slr_mensal / dias_trabalhado

escreva("voce recebe " + qnt_recebe + " por dia")
leia(qnt_recebe)

  }
}
